{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/readteacher", "dest": "api/index.js" },
    { "src": "/addteacher", "dest": "api/index.js" },
    { "src": "/deleteteacher", "dest": "api/index.js" },
    { "src": "/deleteallteachers", "dest": "api/index.js" },
    { "src": "/updateteacher", "dest": "api/index.js" },
    { "src": "/updatesingleteacher", "dest": "api/index.js" },
    { "src": "/", "dest": "public/index.html" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}